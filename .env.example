# ---------------------------------------------------------------------------
# TinyPaste environment configuration
#
# Copy to `.env.local` and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (required for durable storage) -------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon key. Present for completeness; the app does not query the database from
# the browser, and RLS denies this key access to the pastes table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY — it bypasses Row Level Security.
# Never prefix this with NEXT_PUBLIC_, and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -----------------------------------------------------------
# Public origin, used to build share links. No trailing slash.
APP_URL=http://localhost:3000

# --- Rate limiting (optional, recommended in production) -------------------
# Upstash Redis REST endpoint and token. Without these the app falls back to a
# per-instance in-memory limiter, which does not coordinate across serverless
# instances. See docs/SECURITY.md.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# --- Abuse reporting (optional) --------------------------------------------
# When set, the footer "Report abuse" link becomes a mailto: address.
ABUSE_CONTACT_EMAIL=

# --- Expired-paste cleanup (optional) --------------------------------------
# Shared secret for POST /api/cleanup. The route is disabled unless this is set.
CLEANUP_SECRET=

# --- Storage driver (optional) ---------------------------------------------
# 'supabase' or 'memory'. Auto-detected from the Supabase variables when unset.
# TINYPASTE_DB_DRIVER=

# Explicit opt-in required to run the volatile in-memory store in a production
# build. Leave unset unless you genuinely want throwaway storage (demos, E2E).
# TINYPASTE_ALLOW_MEMORY_DB=false

# Optional JSON snapshot path so in-memory dev data survives a restart.
# Defaults to .data/pastes.json outside production.
# TINYPASTE_DEV_DB_FILE=.data/pastes.json

# --- Branding (optional) ---------------------------------------------------
# Shown as the footer "Source" link when set.
NEXT_PUBLIC_REPOSITORY_URL=

# --- Rate limit tuning (optional) ------------------------------------------
# Requests allowed per window, per client. Defaults: 20/min create,
# 10/5min unlock, 30/min edit+delete.
RATE_LIMIT_CREATE=
RATE_LIMIT_UNLOCK=
RATE_LIMIT_MUTATE=
