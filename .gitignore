# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# local dev persistence (in-memory repository snapshots)
.data/

# env files — never commit real secrets.
# Deny every .env* by default and allow back only the placeholder template, so a
# new variant (.env.staging, .env.supabase, .env.backup …) cannot be committed
# by accident. SUPABASE_SERVICE_ROLE_KEY holds the server-side secret key, which
# bypasses Row Level Security.
.env*
!.env.example

# Listed explicitly as well. Both are already covered by the .env* rule above;
# these are here so the two conventional patterns are greppable in this file.
.env.local
.env*.local

# Self-hosted Monaco assets, regenerated by scripts/copy-monaco-assets.mjs
# (wired into predev/prebuild/prestart) — see lib/client/monaco-setup.ts for why
# these are served from this origin instead of loaded from a CDN.
/public/monaco-editor/

# misc
.DS_Store
*.pem
Thumbs.db
*.tsbuildinfo
.vercel
.idea/
.vscode/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local editor/agent config
.claude/

# Agent instruction files. `next dev` regenerates these on every run, so they
# are local scaffolding rather than project source and are never committed.
AGENTS.md
CLAUDE.md
