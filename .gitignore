blob-report/
.playwright/

# local dev persistence (in-memory repository snapshots)
.data/

# env files — never commit real secrets.
# Deny every .env* by default and allow back only the placeholder template, so a
# new variant (.env.staging, .env.supabase, .env.backup …) cannot be committed
# by accident. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
.env*
!.env.example

